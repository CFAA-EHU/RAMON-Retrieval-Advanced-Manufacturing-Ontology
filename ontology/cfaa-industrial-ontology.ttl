ind:hasPart a owl:ObjectProperty ;
    rdfs:label "has part"@en,
        "tiene parte"@es ;
    rdfs:domain ind:IndustrialAsset ;
    rdfs:range ind:Component ;
    owl:inverseOf ind:partOf .

ind:CoolingComponent a owl:Class ;
    rdfs:label "CoolingComponent"@en,
        "Componente de refrigeración"@es ;
    rdfs:subClassOf ind:Component .

ind:Machine a owl:Class ;
    rdfs:label "Machine"@en,
        "Máquina"@es ;
    rdfs:subClassOf ind:IndustrialAsset .

ind:MachineTool a owl:Class ;
    rdfs:label "MachineTool"@en,
        "Máquina-herramienta"@es ;
    rdfs:subClassOf ind:Machine .

ind:Pump a owl:Class ;
    rdfs:label "Pump"@en,
        "Bomba"@es ;
    rdfs:subClassOf ind:FluidPowerComponent .

ind:partOf a owl:ObjectProperty ;
    rdfs:label "part of"@en,
        "parte de"@es ;
    rdfs:domain ind:Component ;
    rdfs:range ind:IndustrialAsset .

ind:Actuator a owl:Class ;
    rdfs:label "Actuator"@en,
        "Actuador"@es ;
    rdfs:subClassOf ind:Component .

ind:LubricationSystem a owl:Class ;
    rdfs:label "LubricationSystem"@en,
        "Sistema de engrase"@es ;
    rdfs:subClassOf ind:Subsystem .

ind:MeasurementDevice a owl:Class ;
    rdfs:label "MeasurementDevice"@en,
        "Dispositivo de medida"@es ;
    rdfs:subClassOf ind:Sensor .

ind:Motor a owl:Class ;
    rdfs:label "Motor"@en,
        "Motor"@es ;
    rdfs:subClassOf ind:Actuator .

ind:SafetyComponent a owl:Class ;
    rdfs:label "SafetyComponent"@en,
        "Componente de seguridad"@es ;
    rdfs:subClassOf ind:Component .

ind:ElectricalComponent a owl:Class ;
    rdfs:label "ElectricalComponent"@en,
        "Componente eléctrico"@es ;
    rdfs:subClassOf ind:Component .

ind:HydraulicComponent a owl:Class ;
    rdfs:label "HydraulicComponent"@en,
        "Componente hidráulico"@es ;
    rdfs:subClassOf ind:FluidPowerComponent .

ind:LubricationComponent a owl:Class ;
    rdfs:label "LubricationComponent"@en,
        "Componente de lubricación"@es ;
    rdfs:subClassOf ind:Component .

ind:Reservoir a owl:Class ;
    rdfs:label "Reservoir"@en,
        "Depósito"@es ;
    rdfs:subClassOf ind:Component .

ind:Valve a owl:Class ;
    rdfs:label "Valve"@en,
        "Válvula"@es ;
    rdfs:subClassOf ind:FluidPowerComponent .

ind:IndustrialAsset a owl:Class ;
    rdfs:label "IndustrialAsset"@en,
        "Activo industrial"@es .

ind:ControlComponent a owl:Class ;
    rdfs:label "ControlComponent"@en,
        "Componente de control"@es ;
    rdfs:subClassOf ind:Component .

ind:FluidPowerComponent a owl:Class ;
    rdfs:label "FluidPowerComponent"@en,
        "Componente de potencia fluida"@es ;
    rdfs:subClassOf ind:Component .

ind:PneumaticComponent a owl:Class ;
    rdfs:label "PneumaticComponent"@en,
        "Componente neumático"@es ;
    rdfs:subClassOf ind:FluidPowerComponent .

ind:Sensor a owl:Class ;
    rdfs:label "Sensor"@en,
