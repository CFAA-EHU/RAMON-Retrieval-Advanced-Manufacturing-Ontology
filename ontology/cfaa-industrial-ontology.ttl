@prefix : <https://cfaa.eus/ontology/industrial#> .
@prefix ind: <https://cfaa.eus/ontology/industrial#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://cfaa.eus/ontology/industrial#> .

<https://cfaa.eus/ontology/industrial> rdf:type owl:Ontology ;
                                        dcterms:description "Minimal industrial ontology for semantic lifting of AAS HierarchicalStructures. Version 0.1 intentionally models only concepts required by the EKIN broaching-machine hierarchy."@en ;
                                        dcterms:title "CFAA Industrial Ontology"@en ,
                                                      "Ontología industrial CFAA"@es ;
                                        owl:versionInfo "0.1" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://cfaa.eus/ontology/industrial#hasPart
ind:hasPart rdf:type owl:ObjectProperty ;
            owl:inverseOf ind:partOf ;
            rdf:type owl:TransitiveProperty ;
            rdfs:domain ind:IndustrialAsset ;
            rdfs:range ind:Component ;
            rdfs:label "has part"@en ,
                       "tiene parte"@es .


###  https://cfaa.eus/ontology/industrial#hasProperty
ind:hasProperty rdf:type owl:ObjectProperty ;
                owl:inverseOf ind:isPropertyOf ;
                rdfs:domain ind:IndustrialAsset ;
                rdfs:range ind:AssetProperty ;
                rdfs:label "has property"@en ,
                           "tiene propiedad"@es .


###  https://cfaa.eus/ontology/industrial#hasTimeSeriesBinding
ind:hasTimeSeriesBinding rdf:type owl:ObjectProperty ;
                         rdfs:domain ind:AssetProperty ;
                         rdfs:range ind:TimeSeriesBinding ;
                         rdfs:label "has time series binding"@en ,
                                    "tiene mapeo de serie temporal"@es .


###  https://cfaa.eus/ontology/industrial#isPropertyOf
ind:isPropertyOf rdf:type owl:ObjectProperty ;
                 rdfs:domain ind:AssetProperty ;
                 rdfs:range ind:IndustrialAsset ;
                 rdfs:label "es propiedad de"@es ,
                            "is property of"@en .


###  https://cfaa.eus/ontology/industrial#partOf
ind:partOf rdf:type owl:ObjectProperty ,
                    owl:TransitiveProperty ;
           rdfs:domain ind:Component ;
           rdfs:range ind:IndustrialAsset ;
           rdfs:label "part of"@en ,
                      "parte de"@es .


###  https://cfaa.eus/ontology/industrial#source
ind:source rdf:type owl:ObjectProperty ;
           rdfs:domain ind:TimeSeriesBinding ;
           rdfs:range ind:InfluxDBSource ;
           rdfs:label "has data source"@en ,
                      "tiene origen de datos"@es .


#################################################################
#    Data properties
#################################################################

###  https://cfaa.eus/ontology/industrial#bucketName
ind:bucketName rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:string ;
               rdfs:label "bucket name"@en ,
                          "nombre del bucket"@es .


###  https://cfaa.eus/ontology/industrial#fieldName
ind:fieldName rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              rdfs:comment "Clave física exacta del field en InfluxDB; en Flux se compara con _field. No es el nombre semántico de la propiedad."@es ;
              rdfs:label "field name"@en ,
                         "nombre del field"@es .


###  https://cfaa.eus/ontology/industrial#measurementName
ind:measurementName rdf:type owl:DatatypeProperty ;
                    rdfs:range xsd:string ;
                    rdfs:label "measurement name"@en ,
                               "nombre del measurement"@es .


#################################################################
#    Classes
#################################################################

###  https://cfaa.eus/ontology/industrial#AccessHatch
ind:AccessHatch rdf:type owl:Class ;
                rdfs:subClassOf ind:StructuralComponent ;
                rdfs:label "AccessHatch"@en ,
                           "Trampilla de acceso"@es .


###  https://cfaa.eus/ontology/industrial#Actuator
ind:Actuator rdf:type owl:Class ;
             rdfs:subClassOf ind:Component ;
             rdfs:label "Actuador"@es ,
                        "Actuator"@en .


###  https://cfaa.eus/ontology/industrial#AirDryer
ind:AirDryer rdf:type owl:Class ;
             rdfs:subClassOf ind:PneumaticComponent ;
             rdfs:label "AirDryer"@en ,
                        "Secador de aire"@es .


###  https://cfaa.eus/ontology/industrial#AssetProperty
ind:AssetProperty rdf:type owl:Class ;
                  rdfs:comment "Propiedad específica de un activo industrial. Sus valores temporales pueden localizarse mediante un mapeo externo."@es ;
                  rdfs:label "Asset property"@en ,
                             "Propiedad de un activo"@es .


###  https://cfaa.eus/ontology/industrial#AutomaticLubricationSystem
ind:AutomaticLubricationSystem rdf:type owl:Class ;
                               rdfs:subClassOf ind:LubricationSystem ;
                               rdfs:label "AutomaticLubricationSystem"@en ,
                                          "Sistema de engrase automático"@es .


###  https://cfaa.eus/ontology/industrial#BroachCarrier
ind:BroachCarrier rdf:type owl:Class ;
                  rdfs:subClassOf ind:MotionComponent ;
                  rdfs:label "BroachCarrier"@en ,
                             "Carro porta-brochas"@es .


###  https://cfaa.eus/ontology/industrial#BroachingMachine
ind:BroachingMachine rdf:type owl:Class ;
                     rdfs:subClassOf ind:MachineTool ;
                     rdfs:label "BroachingMachine"@en ,
                                "Brochadora"@es .


###  https://cfaa.eus/ontology/industrial#Brush
ind:Brush rdf:type owl:Class ;
          rdfs:subClassOf ind:Component ;
          rdfs:label "Brush"@en ,
                     "Cepillo"@es .


###  https://cfaa.eus/ontology/industrial#CNC
ind:CNC rdf:type owl:Class ;
        rdfs:subClassOf ind:ControlComponent ;
        rdfs:label "CNC"@en ,
                   "Control numérico computarizado"@es .


###  https://cfaa.eus/ontology/industrial#CleaningSystem
ind:CleaningSystem rdf:type owl:Class ;
                   rdfs:subClassOf ind:Subsystem ;
                   rdfs:label "CleaningSystem"@en ,
                              "Sistema de limpieza"@es .


###  https://cfaa.eus/ontology/industrial#Component
ind:Component rdf:type owl:Class ;
              rdfs:subClassOf ind:IndustrialAsset ;
              rdfs:label "Component"@en ,
                         "Componente"@es .


###  https://cfaa.eus/ontology/industrial#ControlComponent
ind:ControlComponent rdf:type owl:Class ;
                     rdfs:subClassOf ind:Component ;
                     rdfs:label "Componente de control"@es ,
                                "ControlComponent"@en .


###  https://cfaa.eus/ontology/industrial#CoolantReservoir
ind:CoolantReservoir rdf:type owl:Class ;
                     rdfs:subClassOf ind:CoolingComponent ,
                                     ind:Reservoir ;
                     rdfs:label "CoolantReservoir"@en ,
                                "Depósito de refrigeración"@es .


###  https://cfaa.eus/ontology/industrial#CoolingComponent
ind:CoolingComponent rdf:type owl:Class ;
                     rdfs:subClassOf ind:Component ;
                     rdfs:label "Componente de refrigeración"@es ,
