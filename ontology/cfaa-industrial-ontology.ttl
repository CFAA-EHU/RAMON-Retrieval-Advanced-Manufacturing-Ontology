ind:Coupling rdf:type owl:Class ;
             rdfs:subClassOf ind:Component ;
             rdfs:label "Acoplamiento"@es ,
                        "Coupling"@en .


###  https://cfaa.eus/ontology/industrial#ElectricMotor
ind:ElectricMotor rdf:type owl:Class ;
                  rdfs:subClassOf ind:Motor ;
                  rdfs:label "ElectricMotor"@en ,
                             "Motor eléctrico"@es .


###  https://cfaa.eus/ontology/industrial#ElectricalCabinet
ind:ElectricalCabinet rdf:type owl:Class ;
                      rdfs:subClassOf ind:ElectricalComponent ;
                      rdfs:label "Armario eléctrico"@es ,
