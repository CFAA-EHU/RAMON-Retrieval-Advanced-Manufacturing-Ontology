ind:RemovablePanel a owl:Class ;
    rdfs:label "RemovablePanel"@en,
        "Panel desmontable"@es ;
    rdfs:subClassOf ind:StructuralComponent .

ind:SafetyController a owl:Class ;
    rdfs:label "SafetyController"@en,
        "Controlador de seguridad"@es ;
    rdfs:subClassOf ind:ControlComponent,
        ind:SafetyComponent .

ind:SensorAssembly a owl:Class ;
    rdfs:label "SensorAssembly"@en,
        "Conjunto de sensores"@es ;
    rdfs:subClassOf ind:Sensor .

ind:ServoMotor a owl:Class ;
    rdfs:label "ServoMotor"@en,
        "Servomotor"@es ;
