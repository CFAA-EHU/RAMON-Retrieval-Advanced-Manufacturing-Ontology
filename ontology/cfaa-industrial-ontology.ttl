@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ind: <https://cfaa.eus/ontology/industrial#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://cfaa.eus/ontology/industrial> a owl:Ontology ;
    dcterms:description "Minimal industrial ontology for semantic lifting of AAS HierarchicalStructures. Version 0.1 intentionally models only concepts required by the EKIN broaching-machine hierarchy."@en ;
    dcterms:title "CFAA Industrial Ontology"@en,
        "Ontología industrial CFAA"@es ;
    owl:versionInfo "0.1" .

ind:AccessHatch a owl:Class ;
    rdfs:label "AccessHatch"@en,
        "Trampilla de acceso"@es ;
    rdfs:subClassOf ind:StructuralComponent .

ind:AirDryer a owl:Class ;
    rdfs:label "AirDryer"@en,
        "Secador de aire"@es ;
    rdfs:subClassOf ind:PneumaticComponent .

ind:AutomaticLubricationSystem a owl:Class ;
    rdfs:label "AutomaticLubricationSystem"@en,
        "Sistema de engrase automático"@es ;
    rdfs:subClassOf ind:LubricationSystem .

ind:BroachCarrier a owl:Class ;
    rdfs:label "BroachCarrier"@en,
        "Carro porta-brochas"@es ;
    rdfs:subClassOf ind:MotionComponent .

ind:BroachingMachine a owl:Class ;
    rdfs:label "BroachingMachine"@en,
        "Brochadora"@es ;
    rdfs:subClassOf ind:MachineTool .

ind:Brush a owl:Class ;
    rdfs:label "Brush"@en,
        "Cepillo"@es ;
    rdfs:subClassOf ind:Component .

ind:CNC a owl:Class ;
    rdfs:label "CNC"@en,
        "Control numérico computarizado"@es ;
    rdfs:subClassOf ind:ControlComponent .

ind:CleaningSystem a owl:Class ;
    rdfs:label "CleaningSystem"@en,
        "Sistema de limpieza"@es ;
    rdfs:subClassOf ind:Subsystem .

ind:CoolantReservoir a owl:Class ;
    rdfs:label "CoolantReservoir"@en,
        "Depósito de refrigeración"@es ;
    rdfs:subClassOf ind:CoolingComponent,
        ind:Reservoir .

ind:CoolingSystem a owl:Class ;
    rdfs:label "CoolingSystem"@en,
        "Sistema de refrigeración"@es ;
    rdfs:subClassOf ind:Subsystem .

ind:Counterweight a owl:Class ;
    rdfs:label "Counterweight"@en,
        "Contrapeso"@es ;
    rdfs:subClassOf ind:MotionComponent .

ind:Coupling a owl:Class ;
    rdfs:label "Coupling"@en,
        "Acoplamiento"@es ;
    rdfs:subClassOf ind:Component .

ind:ElectricMotor a owl:Class ;
    rdfs:label "ElectricMotor"@en,
        "Motor eléctrico"@es ;
    rdfs:subClassOf ind:Motor .

ind:ElectricalCabinet a owl:Class ;
    rdfs:label "ElectricalCabinet"@en,
        "Armario eléctrico"@es ;
    rdfs:subClassOf ind:ElectricalComponent .

ind:EmergencyStopButton a owl:Class ;
    rdfs:label "EmergencyStopButton"@en,
        "Pulsador de parada de emergencia"@es ;
    rdfs:subClassOf ind:ElectricalComponent,
        ind:SafetyComponent .

ind:Filter a owl:Class ;
    rdfs:label "Filter"@en,
        "Filtro"@es ;
    rdfs:subClassOf ind:Component .

ind:FilterRegulator a owl:Class ;
    rdfs:label "FilterRegulator"@en,
        "Filtro regulador"@es ;
    rdfs:subClassOf ind:PneumaticComponent .

ind:GuideCarriage a owl:Class ;
    rdfs:label "GuideCarriage"@en,
        "Patín de guía"@es ;
    rdfs:subClassOf ind:MotionComponent .

ind:HumanMachineInterface a owl:Class ;
    rdfs:label "HumanMachineInterface"@en,
        "Interfaz hombre-máquina"@es ;
