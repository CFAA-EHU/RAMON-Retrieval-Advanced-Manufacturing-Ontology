###  https://cfaa.eus/ontology/industrial#TimeSeriesBinding
ind:TimeSeriesBinding rdf:type owl:Class ;
                      rdfs:subClassOf <https://cfaa.eus/ontology/industrial/InformationProcessing> ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty ind:fieldName ;
                                        owl:someValuesFrom xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty ind:measurementName ;
                                        owl:someValuesFrom xsd:string
                                      ] ;
