        ind:Reservoir .

ind:HydraulicSystem a owl:Class ;
    rdfs:label "HydraulicSystem"@en,
        "Sistema hidráulico"@es ;
    rdfs:subClassOf ind:Subsystem .

ind:IndexingBase a owl:Class ;
    rdfs:label "IndexingBase"@en,
        "Base de indexado"@es ;
    rdfs:subClassOf ind:StructuralComponent .

ind:IndexingTable a owl:Class ;
    rdfs:label "IndexingTable"@en,
        "Plato divisor"@es ;
    rdfs:subClassOf ind:MotionComponent .

ind:LevelSensor a owl:Class ;
    rdfs:label "LevelSensor"@en,
        "Sensor de nivel"@es ;
    rdfs:subClassOf ind:Sensor .

