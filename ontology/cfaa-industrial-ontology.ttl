ind:LinearScale a owl:Class ;
    rdfs:label "LinearScale"@en,
        "Regla lineal"@es ;
    rdfs:subClassOf ind:Sensor .

ind:LubricantReservoir a owl:Class ;
    rdfs:label "LubricantReservoir"@en,
        "Depósito de lubricante"@es ;
    rdfs:subClassOf ind:LubricationComponent,
        ind:Reservoir .

ind:LubricationUnit a owl:Class ;
    rdfs:label "LubricationUnit"@en,
        "Central de engrase"@es ;
    rdfs:subClassOf ind:LubricationComponent .

ind:MachineBase a owl:Class ;
    rdfs:label "MachineBase"@en,
        "Zócalo de máquina"@es ;
    rdfs:subClassOf ind:StructuralComponent .

ind:MachineColumn a owl:Class ;
    rdfs:label "MachineColumn"@en,
        "Columna de máquina"@es ;
    rdfs:subClassOf ind:StructuralComponent .

ind:MachineEnclosure a owl:Class ;
    rdfs:label "MachineEnclosure"@en,
        "Carenado"@es ;
    rdfs:subClassOf ind:StructuralComponent .

ind:MainSwitch a owl:Class ;
    rdfs:label "MainSwitch"@en,
        "Interruptor general"@es ;
    rdfs:subClassOf ind:ElectricalComponent .

ind:ManualLubricationSystem a owl:Class ;
    rdfs:label "ManualLubricationSystem"@en,
        "Sistema de engrase manual"@es ;
    rdfs:subClassOf ind:LubricationSystem .

ind:ManualValve a owl:Class ;
    rdfs:label "ManualValve"@en,
        "Válvula manual"@es ;
    rdfs:subClassOf ind:Valve .

ind:OperatorControlPanel a owl:Class ;
    rdfs:label "OperatorControlPanel"@en,
        "Botonera de operación"@es ;
    rdfs:subClassOf ind:ControlComponent .

ind:PLC a owl:Class ;
    rdfs:label "PLC"@en,
        "Controlador lógico programable"@es ;
