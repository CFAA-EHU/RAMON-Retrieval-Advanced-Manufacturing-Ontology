        ind:PneumaticComponent .

ind:PneumaticLubricator a owl:Class ;
    rdfs:label "PneumaticLubricator"@en,
        "Lubricador neumático"@es ;
    rdfs:subClassOf ind:LubricationComponent,
        ind:PneumaticComponent .

ind:PneumaticSystem a owl:Class ;
    rdfs:label "PneumaticSystem"@en,
        "Sistema neumático"@es ;
