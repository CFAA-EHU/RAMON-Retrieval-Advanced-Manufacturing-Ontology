                    rdfs:label "HydraulicSystem"@en ,
                               "Sistema hidráulico"@es .


###  https://cfaa.eus/ontology/industrial#IndexingBase
ind:IndexingBase rdf:type owl:Class ;
                 rdfs:subClassOf ind:StructuralComponent ;
                 rdfs:label "Base de indexado"@es ,
                            "IndexingBase"@en .


###  https://cfaa.eus/ontology/industrial#IndexingTable
ind:IndexingTable rdf:type owl:Class ;
                  rdfs:subClassOf ind:MotionComponent ;
                  rdfs:label "IndexingTable"@en ,
                             "Plato divisor"@es .


###  https://cfaa.eus/ontology/industrial#IndustrialAsset
ind:IndustrialAsset rdf:type owl:Class ;
                    rdfs:label "Activo industrial"@es ,
                               "IndustrialAsset"@en .


###  https://cfaa.eus/ontology/industrial#InfluxDBSource
ind:InfluxDBSource rdf:type owl:Class ;
                   rdfs:subClassOf <https://cfaa.eus/ontology/industrial/OrigenDatos> ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ind:bucketName ;
                                     owl:someValuesFrom xsd:string
                                   ] ;
                   rdfs:comment "Identificación lógica de un origen InfluxDB y su bucket. La aplicación resuelve la conexión, organización y credenciales mediante esta identificación."@es ;
                   rdfs:label "InfluxDB data source"@en ,
                              "Origen de datos InfluxDB"@es .


###  https://cfaa.eus/ontology/industrial#LevelSensor
ind:LevelSensor rdf:type owl:Class ;
                rdfs:subClassOf ind:Sensor ;
                rdfs:label "LevelSensor"@en ,
                           "Sensor de nivel"@es .


###  https://cfaa.eus/ontology/industrial#LevelTemperatureIndicator
ind:LevelTemperatureIndicator rdf:type owl:Class ;
                              rdfs:subClassOf ind:MeasurementDevice ;
                              rdfs:label "Indicador de nivel y temperatura"@es ,
                                         "LevelTemperatureIndicator"@en .


